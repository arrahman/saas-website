# Copy to .env.local for local development.
# Demo-request Worker endpoint (leave empty to preview the success state without sending).
VITE_DEMO_ENDPOINT=https://forms.knowex.ai/demo-request
# Turnstile site key. 1x00000000000000000000AA is Cloudflare's always-pass test key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
