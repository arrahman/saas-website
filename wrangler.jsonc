// Cloudflare Workers static-assets deploy for knowex.ai.
// Cloudflare runs `npm run build`, then `npx wrangler deploy` publishes ./dist.
{
  "name": "saas-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
